; Engine configuration file.
; It's best edited using the editor UI or command line,
; as not all keys are supported by the editor.
; For the complete set of supported keys, see the documentation.

[application]

config/name="Wildfall"
config/version="0.1.0"
run/main_scene="res://scenes/main.tscn"
config/features="4.6"

[display]

window/size/viewport_width=1280
window/size/viewport_height=720
window/stretch/mode="canvas_items"

[rendering]

renderer/rendering_method="glsl4"
textures/canvas_textures/default_texture_filter=1

[input]

; Movement uses logical keycodes (layout-independent): "W" means the key
; labelled W on the user's keyboard layout. Arrow keys are bound too.
move_up={
"deadzone": 0.5, "events": [Object(InputEventKey,"resource_local_to_scene":false,"keycode":87,"physical_keycode":0,"unicode":119,"echo":false,"shortcut":false), Object(InputEventKey,"resource_local_to_scene":false,"keycode":4194320,"physical_keycode":0,"unicode":0,"echo":false,"shortcut":false)]
}
